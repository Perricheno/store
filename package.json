{
  "name": "urbanmag",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev --webpack",
    "build": "next build apps/web --webpack",
    "start": "node scripts/run-next.mjs start",
    "worker": "node --import tsx scripts/run-worker.mjs",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/core/tsconfig.json",
    "test": "npm run test --workspace @urbanmag/core && npm run test --workspace @urbanmag/worker && tsx --test tests/security.test.ts tests/cart-store.test.ts tests/buyer-device.test.ts",
    "test:e2e": "playwright test",
    "bootstrap": "node scripts/bootstrap.mjs",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/inter": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
