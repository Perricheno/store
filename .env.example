# Copy to .env.dev or .env.prod; never commit real credentials.
POSTGRES_PASSWORD=
DATABASE_URL=
APP_URL=https://u.perricheno.com
STAFF_URL=https://staff-u.perricheno.com
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
APP_SECRET=
MAIL_ENCRYPTION_KEY=
APIPAY_MODE=sandbox
APIPAY_API_KEY=
APIPAY_WEBHOOK_SECRET=
SMTP_URL=
MAIL_FROM=
UPLOADS_DIR=/data/uploads
IMAGE_TAG=
SEO_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=

# Development access only; production always ignores these settings.
DEV_ACCESS_ENABLED=false
DEV_ACCESS_PASSWORD_HASH=

# Enable real-money buyer wallet topups/payments only after merchant approval of this workflow.
# Sandbox and mock balances are isolated from production; this flag defaults to false.
WALLET_PRODUCTION_ENABLED=false
